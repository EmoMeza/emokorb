# ─── Backend ───────────────────────────────────────────
PORT=3000
MONGO_URI=mongodb://localhost:27017/lista_compras
JWT_SECRET=supersecretkey_change_in_production
JWT_EXPIRES_IN=7d

# ─── CORS (prod: URL exacta del frontend) ──────────────
FRONTEND_URL=https://compras.emomeza.com

# ─── Límite de usuarios registrados (default: 10) ──────
MAX_USUARIOS=10

# ─── Producción (usar estas en .env del servidor) ──────
# MONGO_URI=mongodb://mongo:27017/lista_compras
# JWT_SECRET=<genera uno con: openssl rand -hex 32>
